<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg"
    android:paddingStart="16dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="10dp">

    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
        <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/text" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="8dp" android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold" />
        <TextView android:id="@+id/refresh" android:layout_width="36dp" android:layout_height="32dp" android:gravity="center"
            android:text="↻" android:textColor="@color/sub" android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
        <ImageView android:id="@+id/box0" android:layout_width="34dp" android:layout_height="30dp"
            android:paddingStart="2dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:src="@drawable/box" android:contentDescription="완료" />
        <TextView android:id="@+id/title0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/time0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/sub" android:textSize="12sp" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
        <ImageView android:id="@+id/box1" android:layout_width="34dp" android:layout_height="30dp"
            android:paddingStart="2dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:src="@drawable/box" android:contentDescription="완료" />
        <TextView android:id="@+id/title1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/time1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/sub" android:textSize="12sp" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
        <ImageView android:id="@+id/box2" android:layout_width="34dp" android:layout_height="30dp"
            android:paddingStart="2dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:src="@drawable/box" android:contentDescription="완료" />
        <TextView android:id="@+id/title2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/time2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/sub" android:textSize="12sp" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
        <ImageView android:id="@+id/box3" android:layout_width="34dp" android:layout_height="30dp"
            android:paddingStart="2dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:src="@drawable/box" android:contentDescription="완료" />
        <TextView android:id="@+id/title3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/time3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/sub" android:textSize="12sp" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
        <ImageView android:id="@+id/box4" android:layout_width="34dp" android:layout_height="30dp"
            android:paddingStart="2dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:src="@drawable/box" android:contentDescription="완료" />
        <TextView android:id="@+id/title4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/time4" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/sub" android:textSize="12sp" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
        <ImageView android:id="@+id/box5" android:layout_width="34dp" android:layout_height="30dp"
            android:paddingStart="2dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:src="@drawable/box" android:contentDescription="완료" />
        <TextView android:id="@+id/title5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/time5" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/sub" android:textSize="12sp" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row6" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
        <ImageView android:id="@+id/box6" android:layout_width="34dp" android:layout_height="30dp"
            android:paddingStart="2dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:src="@drawable/box" android:contentDescription="완료" />
        <TextView android:id="@+id/title6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/time6" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/sub" android:textSize="12sp" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row7" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
        <ImageView android:id="@+id/box7" android:layout_width="34dp" android:layout_height="30dp"
            android:paddingStart="2dp" android:paddingEnd="12dp" android:paddingTop="5dp" android:paddingBottom="5dp"
            android:src="@drawable/box" android:contentDescription="완료" />
        <TextView android:id="@+id/title7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="@color/text" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/time7" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/sub" android:textSize="12sp" android:layout_marginStart="6dp" />
    </LinearLayout>
    <TextView android:id="@+id/more" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="34dp" android:textColor="@color/sub" android:textSize="12sp" android:visibility="gone" />
    <TextView android:id="@+id/msg" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center" android:textColor="@color/sub" android:textSize="14sp" android:visibility="gone" />
</LinearLayout>
